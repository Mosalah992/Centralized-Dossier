{
  "name": "centralized-dossier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Thalmor Embassy Archives — public web archive over the Corps roster sheet",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.functions.json",
    "dump": "node scripts/dump-tabs.mjs",
    "pages:dev": "wrangler pages dev",
    "pages:deploy": "wrangler pages deploy"
  },
  "dependencies": {
    "motion": "^13.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^18.19.130",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "sharp": "^0.33.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wrangler": "^3.114.17"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.17.19": true,
    "sharp@0.33.5": true,
    "workerd@1.20250718.0": true
  }
}
